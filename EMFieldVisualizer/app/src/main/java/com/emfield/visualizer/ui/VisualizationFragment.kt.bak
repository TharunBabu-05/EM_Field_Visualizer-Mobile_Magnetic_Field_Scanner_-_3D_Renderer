package com.emfield.visualizer.ui

import android.content.ComponentName
import android.content.Context
import android.content.Intent
import android.content.ServiceConnection
import android.opengl.GLSurfaceView
import android.os.Bundle
import android.os.IBinder
import android.view.LayoutInflater
import android.view.MotionEvent
import android.view.View
import android.view.ViewGroup
import android.widget.Toast
import androidx.fragment.app.Fragment
import androidx.lifecycle.lifecycleScope
import com.emfield.visualizer.R
import com.emfield.visualizer.databinding.FragmentVisualizationBinding
import com.emfield.visualizer.rendering.CameraController
import com.emfield.visualizer.rendering.GLRenderer
import com.emfield.visualizer.rendering.VisualizationMode
import com.emfield.visualizer.sensors.SensorMonitorService
import com.emfield.visualizer.utils.ExportManager
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext

/**
 * Fragment for 3D visualization of magnetic field data
 */
class VisualizationFragment : Fragment() {
    
    private var _binding: FragmentVisualizationBinding? = null
    private val binding get() = _binding!!
    
    private lateinit var glRenderer: GLRenderer
    private lateinit var cameraController: CameraController
    private lateinit var exportManager: ExportManager
    
    private var sensorService: SensorMonitorService? = null
    private var serviceBound = false
    
    private var lastUpdateTime = 0L
    
    private val serviceConnection = object : ServiceConnection {
        override fun onServiceConnected(name: ComponentName?, service: IBinder?) {
            val binder = service as SensorMonitorService.LocalBinder
            sensorService = binder.getService()
            serviceBound = true
            updateVisualization()
        }
        
        override fun onServiceDisconnected(name: ComponentName?) {
            sensorService = null
            serviceBound = false
        }
    }
    
    override fun onCreateView(
        inflater: LayoutInflater,
        container: ViewGroup?,
        savedInstanceState: Bundle?
    ): View {
        _binding = FragmentVisualizationBinding.inflate(inflater, container, false)
        return binding.root
    }
    
    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
        super.onViewCreated(view, savedInstanceState)
        
        exportManager = ExportManager(requireContext())
        
        setupGLSurfaceView()
        setupUI()
        bindService()
    }
    
    private fun setupGLSurfaceView() {
        // Create renderer
        glRenderer = GLRenderer(requireContext())
        
        // Create camera controller
        cameraController = CameraController(glRenderer)
        cameraController.setupScaleGestureDetector(requireContext())
        
        // Setup GLSurfaceView
        binding.glSurfaceView.apply {
            setEGLContextClientVersion(3)  // OpenGL ES 3.0
            setRenderer(glRenderer)
            renderMode = GLSurfaceView.RENDERMODE_CONTINUOUSLY
            
            // Handle touch events
            setOnTouchListener { _, event ->
                cameraController.handleTouchEvent(event)
                true
            }
        }
    }
    
    private fun setupUI() {
        // Visualization mode chips
        binding.visualizationModeChips.setOnCheckedChangeListener { _, checkedId ->
            val mode = when (checkedId) {
                R.id.chip_vectors -> VisualizationMode.VECTORS
                R.id.chip_heatmap -> VisualizationMode.HEATMAP
                R.id.chip_particles -> VisualizationMode.PARTICLES
                else -> VisualizationMode.VECTORS
            }
            
            binding.glSurfaceView.queueEvent {
                glRenderer.setVisualizationMode(mode)
            }
        }
        
        // Reset camera button
        binding.resetCameraButton.setOnClickListener {
            binding.glSurfaceView.queueEvent {
                glRenderer.resetCamera()
            }
        }
        
        // Export button
        binding.exportButton.setOnClickListener {
            exportData()
        }
    }
    
    private fun bindService() {
        val intent = Intent(requireContext(), SensorMonitorService::class.java)
        requireContext().bindService(intent, serviceConnection, Context.BIND_AUTO_CREATE)
    }
    
    private fun updateVisualization() {
        val service = sensorService ?: return
        
        // Update data periodically
        lifecycleScope.launch {
            while (serviceBound) {
                val currentTime = System.currentTimeMillis()
                
                // Update every 100ms (10 FPS data update)
                if (currentTime - lastUpdateTime >= 100) {
                    val dataPoints = service.getSpatialMapper().getAllDataPoints()
                    
                    binding.glSurfaceView.queueEvent {
                        glRenderer.updateData(dataPoints)
                        
                        // Update particles if in particle mode
                        if (glRenderer.getVisualizationMode() == VisualizationMode.PARTICLES) {
                            val deltaTime = (currentTime - lastUpdateTime) / 1000f
                            glRenderer.updateParticles(deltaTime)
                        }
                    }
                    
                    lastUpdateTime = currentTime
                }
                
                kotlinx.coroutines.delay(50)  // Check every 50ms
            }
        }
    }
    
    private fun exportData() {
        val service = sensorService
        if (service == null) {
            Toast.makeText(context, "No data to export", Toast.LENGTH_SHORT).show()
            return
        }
        
        val dataPoints = service.getSpatialMapper().getAllDataPoints()
        if (dataPoints.isEmpty()) {
            Toast.makeText(context, "No data points collected", Toast.LENGTH_SHORT).show()
            return
        }
        
        // Show export options
        val options = arrayOf(
            getString(R.string.export_csv),
            getString(R.string.export_json),
            getString(R.string.export_obj)
        )
        
        androidx.appcompat.app.AlertDialog.Builder(requireContext())
            .setTitle("Export Format")
            .setItems(options) { _, which ->
                when (which) {
                    0 -> exportAsCSV(dataPoints)
                    1 -> exportAsJSON(dataPoints)
                    2 -> exportAsOBJ(dataPoints)
                }
            }
            .show()
    }
    
    private fun exportAsCSV(dataPoints: List<com.emfield.visualizer.data.MagneticFieldData>) {
        lifecycleScope.launch {
            val result = withContext(Dispatchers.IO) {
                exportManager.exportToCSV(dataPoints)
            }
            
            if (result != null) {
                shareFile(result)
                Toast.makeText(context, R.string.export_success, Toast.LENGTH_SHORT).show()
            } else {
                Toast.makeText(context, "Export failed", Toast.LENGTH_SHORT).show()
            }
        }
    }
    
    private fun exportAsJSON(dataPoints: List<com.emfield.visualizer.data.MagneticFieldData>) {
        lifecycleScope.launch {
            val result = withContext(Dispatchers.IO) {
                exportManager.exportToJSON(dataPoints)
            }
            
            if (result != null) {
                shareFile(result)
                Toast.makeText(context, R.string.export_success, Toast.LENGTH_SHORT).show()
            } else {
                Toast.makeText(context, "Export failed", Toast.LENGTH_SHORT).show()
            }
        }
    }
    
    private fun exportAsOBJ(dataPoints: List<com.emfield.visualizer.data.MagneticFieldData>) {
        lifecycleScope.launch {
            val result = withContext(Dispatchers.IO) {
                exportManager.exportToOBJ(dataPoints)
            }
            
            if (result != null) {
                shareFile(result)
                Toast.makeText(context, R.string.export_success, Toast.LENGTH_SHORT).show()
            } else {
                Toast.makeText(context, "Export failed", Toast.LENGTH_SHORT).show()
            }
        }
    }
    
    private fun shareFile(file: java.io.File) {
        val uri = androidx.core.content.FileProvider.getUriForFile(
            requireContext(),
            "${requireContext().packageName}.fileprovider",
            file
        )
        
        val shareIntent = Intent(Intent.ACTION_SEND).apply {
            type = when {
                file.name.endsWith(".csv") -> "text/csv"
                file.name.endsWith(".json") -> "application/json"
                file.name.endsWith(".obj") -> "model/obj"
                else -> "application/octet-stream"
            }
            putExtra(Intent.EXTRA_STREAM, uri)
            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
        }
        
        startActivity(Intent.createChooser(shareIntent, "Export Data"))
    }
    
    override fun onResume() {
        super.onResume()
        binding.glSurfaceView.onResume()
    }
    
    override fun onPause() {
        super.onPause()
        binding.glSurfaceView.onPause()
    }
    
    override fun onDestroyView() {
        super.onDestroyView()
        
        if (serviceBound) {
            requireContext().unbindService(serviceConnection)
            serviceBound = false
        }
        
        binding.glSurfaceView.queueEvent {
            glRenderer.cleanup()
        }
        
        _binding = null
    }
}
