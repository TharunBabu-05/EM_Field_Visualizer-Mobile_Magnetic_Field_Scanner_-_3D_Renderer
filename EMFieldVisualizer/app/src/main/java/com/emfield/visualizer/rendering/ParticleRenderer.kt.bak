package com.emfield.visualizer.rendering

import android.content.Context
import android.opengl.GLES30
import android.opengl.Matrix
import android.util.Log
import com.emfield.visualizer.R
import com.emfield.visualizer.data.MagneticFieldData
import com.emfield.visualizer.data.Vector3
import java.nio.ByteBuffer
import java.nio.ByteOrder
import java.nio.FloatBuffer
import kotlin.math.cos
import kotlin.math.sin
import kotlin.random.Random

/**
 * Renders particle flow animation following magnetic field gradients
 */
class ParticleRenderer(private val context: Context) {
    
    private var program = 0
    private var vertexBuffer: FloatBuffer? = null
    private var colorBuffer: FloatBuffer? = null
    private var velocityBuffer: FloatBuffer? = null
    private var lifeBuffer: FloatBuffer? = null
    
    private var maxParticles = 1000
    private var activeParticles = 0
    
    // Shader attribute/uniform locations
    private var positionHandle = 0
    private var colorHandle = 0
    private var velocityHandle = 0
    private var lifeHandle = 0
    private var mvpMatrixHandle = 0
    private var timeHandle = 0
    private var particleSizeHandle = 0
    
    // Particle system data
    private val particles = mutableListOf<Particle>()
    private var fieldData = emptyList<MagneticFieldData>()
    private var time = 0f
    
    init {
        setupShaders()
        initializeParticles()
    }
    
    private fun setupShaders() {
        val vertexShaderCode = """
            #version 300 es
            layout (location = 0) in vec3 aPosition;
            layout (location = 1) in vec3 aColor;
            layout (location = 2) in vec3 aVelocity;
            layout (location = 3) in float aLife;
            
            uniform mat4 uMVPMatrix;
            uniform float uTime;
            uniform float uParticleSize;
            
            out vec3 vColor;
            out float vAlpha;
            
            void main() {
                vec3 pos = aPosition;
                
                // Add some motion based on velocity and time
                pos += aVelocity * uTime * 0.1;
                
                // Make particles pulsate
                float pulse = sin(uTime * 5.0 + aLife * 10.0) * 0.1 + 1.0;
                gl_PointSize = uParticleSize * pulse;
                
                gl_Position = uMVPMatrix * vec4(pos, 1.0);
                vColor = aColor;
                vAlpha = 1.0 - aLife; // Fade out over lifetime
            }
        """.trimIndent()
        
        val fragmentShaderCode = """
            #version 300 es
            precision mediump float;
            
            in vec3 vColor;
            in float vAlpha;
            
            out vec4 fragColor;
            
            void main() {
                // Create circular particles
                vec2 coord = gl_PointCoord - vec2(0.5);
                float distance = length(coord);
                
                if (distance > 0.5) {
                    discard;
                }
                
                // Soft edge
                float alpha = (1.0 - distance * 2.0) * vAlpha;
                fragColor = vec4(vColor, alpha);
            }
        """.trimIndent()
        
        val vertexShader = loadShader(GLES30.GL_VERTEX_SHADER, vertexShaderCode)
        val fragmentShader = loadShader(GLES30.GL_FRAGMENT_SHADER, fragmentShaderCode)
        
        program = GLES30.glCreateProgram().also {
            GLES30.glAttachShader(it, vertexShader)
            GLES30.glAttachShader(it, fragmentShader)
            GLES30.glLinkProgram(it)
            
            val linkStatus = IntArray(1)
            GLES30.glGetProgramiv(it, GLES30.GL_LINK_STATUS, linkStatus, 0)
            if (linkStatus[0] == 0) {
                val error = GLES30.glGetProgramInfoLog(it)
                GLES30.glDeleteProgram(it)
                throw RuntimeException("Error linking program: $error")
            }
        }
        
        positionHandle = GLES30.glGetAttribLocation(program, "aPosition")
        colorHandle = GLES30.glGetAttribLocation(program, "aColor")
        velocityHandle = GLES30.glGetAttribLocation(program, "aVelocity")
        lifeHandle = GLES30.glGetAttribLocation(program, "aLife")
        mvpMatrixHandle = GLES30.glGetUniformLocation(program, "uMVPMatrix")
        timeHandle = GLES30.glGetUniformLocation(program, "uTime")
        particleSizeHandle = GLES30.glGetUniformLocation(program, "uParticleSize")
        
        Log.i(TAG, "Particle shaders compiled successfully")
    }
    
    private fun initializeParticles() {
        particles.clear()
        repeat(maxParticles) {
            particles.add(Particle())
        }
                Random.nextFloat() * 0.2f - 0.1f,
                Random.nextFloat() * 0.2f - 0.1f,
                Random.nextFloat() * 0.2f - 0.1f
            )
        }
        
        particle.velocity = Vector3.ZERO
        particle.lifetime = 0f
    }
    
    private fun updateBuffers() {
        val positions = FloatArray(particles.size * 3)
        val velocities = FloatArray(particles.size * 3)
        val lifetimes = FloatArray(particles.size)
        
        particles.forEachIndexed { index, particle ->
            positions[index * 3] = particle.position.x
            positions[index * 3 + 1] = particle.position.y
            positions[index * 3 + 2] = particle.position.z
            
            velocities[index * 3] = particle.velocity.x
            velocities[index * 3 + 1] = particle.velocity.y
            velocities[index * 3 + 2] = particle.velocity.z
            
            lifetimes[index] = particle.lifetime
        }
        
        vertexBuffer = ByteBuffer.allocateDirect(positions.size * 4)
            .order(ByteOrder.nativeOrder())
            .asFloatBuffer()
            .apply {
                put(positions)
                position(0)
            }
        
        velocityBuffer = ByteBuffer.allocateDirect(velocities.size * 4)
            .order(ByteOrder.nativeOrder())
            .asFloatBuffer()
            .apply {
                put(velocities)
                position(0)
            }
        
        lifetimeBuffer = ByteBuffer.allocateDirect(lifetimes.size * 4)
            .order(ByteOrder.nativeOrder())
            .asFloatBuffer()
            .apply {
                put(lifetimes)
                position(0)
            }
    }
    
    fun draw(mvpMatrix: FloatArray, dataPoints: List<MagneticFieldData>) {
        lastDataPoints = dataPoints
        
        if (particles.isEmpty()) return
        
        // Use program
        GLES30.glUseProgram(program)
        
        // Set uniforms
        GLES30.glUniformMatrix4fv(mvpMatrixHandle, 1, false, mvpMatrix, 0)
        GLES30.glUniform1f(timeHandle, currentTime)
        
        // Set vertex attributes
        vertexBuffer?.let { buffer ->
            buffer.position(0)
            GLES30.glEnableVertexAttribArray(positionHandle)
            GLES30.glVertexAttribPointer(
                positionHandle, 3, GLES30.GL_FLOAT, false, 0, buffer
            )
        }
        
        velocityBuffer?.let { buffer ->
            buffer.position(0)
            GLES30.glEnableVertexAttribArray(velocityHandle)
            GLES30.glVertexAttribPointer(
                velocityHandle, 3, GLES30.GL_FLOAT, false, 0, buffer
            )
        }
        
        lifetimeBuffer?.let { buffer ->
            buffer.position(0)
            GLES30.glEnableVertexAttribArray(lifetimeHandle)
            GLES30.glVertexAttribPointer(
                lifetimeHandle, 1, GLES30.GL_FLOAT, false, 0, buffer
            )
        }
        
        // Draw particles
        GLES30.glDrawArrays(GLES30.GL_POINTS, 0, particles.size)
        
        // Disable arrays
        GLES30.glDisableVertexAttribArray(positionHandle)
        GLES30.glDisableVertexAttribArray(velocityHandle)
        GLES30.glDisableVertexAttribArray(lifetimeHandle)
    }
    
    private fun loadShader(type: Int, shaderCode: String): Int {
        return GLES30.glCreateShader(type).also { shader ->
            GLES30.glShaderSource(shader, shaderCode)
            GLES30.glCompileShader(shader)
            
            val compileStatus = IntArray(1)
            GLES30.glGetShaderiv(shader, GLES30.GL_COMPILE_STATUS, compileStatus, 0)
            if (compileStatus[0] == 0) {
                val error = GLES30.glGetShaderInfoLog(shader)
                GLES30.glDeleteShader(shader)
                throw RuntimeException("Error compiling particle shader: $error")
            }
        }
    }
    
    private fun loadShaderFromResource(resourceId: Int): String {
        return context.resources.openRawResource(resourceId)
            .bufferedReader()
            .use { it.readText() }
    }
    
    fun cleanup() {
        if (program != 0) {
            GLES30.glDeleteProgram(program)
            program = 0
        }
    }
    
    companion object {
        private const val TAG = "ParticleRenderer"
        private const val MAX_PARTICLES = 500
        private const val PARTICLE_MAX_LIFETIME = 5f  // seconds
    }
}

/**
 * Single particle data
 */
data class Particle(
    var position: Vector3,
    var velocity: Vector3,
    var lifetime: Float
)
