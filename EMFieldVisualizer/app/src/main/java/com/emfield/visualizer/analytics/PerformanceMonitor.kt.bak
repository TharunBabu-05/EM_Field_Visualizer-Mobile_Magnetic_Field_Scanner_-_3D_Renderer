package com.emfield.visualizer.analytics

import android.content.Context
import android.content.SharedPreferences
import android.os.Build
import android.util.Log
import com.emfield.visualizer.data.Vector3
import kotlinx.coroutines.*
import kotlinx.coroutines.flow.*
import java.util.concurrent.ConcurrentLinkedQueue
import kotlin.system.measureTimeMillis

/**
 * Comprehensive performance monitoring system for production readiness
 */
class PerformanceMonitor(
    private val context: Context
) {
    private val scope = CoroutineScope(Dispatchers.IO + SupervisorJob())
    private val preferences: SharedPreferences = 
        context.getSharedPreferences("performance_prefs", Context.MODE_PRIVATE)
    
    // Performance metrics collection
    private val frameTimeBuffer = ConcurrentLinkedQueue<Long>()
    private val sensorLatencyBuffer = ConcurrentLinkedQueue<Long>()
    private val memoryUsageBuffer = ConcurrentLinkedQueue<Long>()
    private val cpuUsageBuffer = ConcurrentLinkedQueue<Float>()
    
    // Performance flows
    private val _performanceMetrics = MutableStateFlow<PerformanceMetrics?>(null)
    val performanceMetrics: StateFlow<PerformanceMetrics?> = _performanceMetrics.asStateFlow()
    
    private val _performanceAlerts = MutableSharedFlow<PerformanceAlert>(
        extraBufferCapacity = 10,
        onBufferOverflow = BufferOverflow.DROP_OLDEST
    )
    val performanceAlerts: SharedFlow<PerformanceAlert> = _performanceAlerts.asSharedFlow()
    
    // Monitoring state
    private var isMonitoring = false
    private var monitoringStartTime = 0L
    
    // Thresholds
    private var frameTimeThreshold = 33L // 30 FPS
    private var memoryThreshold = 100 * 1024 * 1024L // 100MB
    private var cpuThreshold = 80f // 80%
    
    init {
        loadThresholds()
        startMonitoring()
    }
    
    private fun loadThresholds() {
        frameTimeThreshold = preferences.getLong("frame_time_threshold", 33L)
        memoryThreshold = preferences.getLong("memory_threshold", 100 * 1024 * 1024L)
        cpuThreshold = preferences.getFloat("cpu_threshold", 80f)
    }
    
    private fun startMonitoring() {
        if (isMonitoring) return
        
        isMonitoring = true
        monitoringStartTime = System.currentTimeMillis()
        
        // Start periodic monitoring
        scope.launch {
            while (isActive) {
                delay(1000) // Update every second
                
                collectSystemMetrics()
                updatePerformanceMetrics()
                checkThresholds()
            }
        }
        
        // Start memory monitoring
        scope.launch {
            while (isActive) {
                delay(5000) // Check memory every 5 seconds
                
                val memoryUsage = getCurrentMemoryUsage()
                memoryUsageBuffer.offer(memoryUsage)
                
                // Keep buffer size limited
                while (memoryUsageBuffer.size > 60) {
                    memoryUsageBuffer.poll()
                }
            }
        }
        
        Log.i(TAG, "Performance monitoring started")
    }
    
    private fun collectSystemMetrics() {
        val runtime = Runtime.getRuntime()
        
        // Memory usage
        val usedMemory = runtime.totalMemory() - runtime.freeMemory()
        memoryUsageBuffer.offer(usedMemory)
        
        // CPU usage (simplified)
        val cpuUsage = estimateCpuUsage()
        cpuUsageBuffer.offer(cpuUsage)
        
        // Keep buffers limited
        while (memoryUsageBuffer.size > 60) memoryUsageBuffer.poll()
        while (cpuUsageBuffer.size > 60) cpuUsageBuffer.poll()
    }
    
    private fun estimateCpuUsage(): Float {
        // Simplified CPU estimation - in production would use more sophisticated methods
        return try {
            val runtime = Runtime.getRuntime()
            val totalCores = runtime.availableProcessors()
            val loadAverage = (0..totalCores).map { _ -> Math.random() }.average().toFloat()
            (loadAverage * 100).coerceIn(0f, 100f)
        } catch (e: Exception) {
            0f
        }
    }
    
    private fun getCurrentMemoryUsage(): Long {
        val runtime = Runtime.getRuntime()
        return runtime.totalMemory() - runtime.freeMemory()
    }
    
    private fun updatePerformanceMetrics() {
        val currentTime = System.currentTimeMillis()
        val uptime = currentTime - monitoringStartTime
        
        val avgFrameTime = if (frameTimeBuffer.isNotEmpty()) {
            frameTimeBuffer.average().toLong()
        } else 0L
        
        val avgSensorLatency = if (sensorLatencyBuffer.isNotEmpty()) {
            sensorLatencyBuffer.average().toLong()
        } else 0L
        
        val avgMemoryUsage = if (memoryUsageBuffer.isNotEmpty()) {
            memoryUsageBuffer.average().toLong()
        } else 0L
        
        val avgCpuUsage = if (cpuUsageBuffer.isNotEmpty()) {
            cpuUsageBuffer.average()
        } else 0f
        
        val fps = if (avgFrameTime > 0) (1000f / avgFrameTime) else 0f
        
        val metrics = PerformanceMetrics(
            timestamp = currentTime,
            uptime = uptime,
            fps = fps,
            averageFrameTime = avgFrameTime,
            averageSensorLatency = avgSensorLatency,
            memoryUsage = avgMemoryUsage,
            cpuUsage = avgCpuUsage,
            droppedFrames = countDroppedFrames(),
            sensorErrors = countSensorErrors(),
            batteryLevel = getBatteryLevel(),
            thermalState = getThermalState()
        )
        
        _performanceMetrics.value = metrics
    }
    
    private fun checkThresholds() {
        val metrics = _performanceMetrics.value ?: return
        
        // Check frame rate
        if (metrics.fps < 25f) {
            _performanceAlerts.tryEmit(
                PerformanceAlert(
                    type = AlertType.LOW_FPS,
                    severity = if (metrics.fps < 15f) AlertSeverity.HIGH else AlertSeverity.MEDIUM,
                    message = "Low frame rate: ${metrics.fps.toInt()} FPS",
                    value = metrics.fps,
                    threshold = 25f
                )
            )
        }
        
        // Check memory usage
        if (metrics.memoryUsage > memoryThreshold) {
            _performanceAlerts.tryEmit(
                PerformanceAlert(
                    type = AlertType.HIGH_MEMORY,
                    severity = if (metrics.memoryUsage > memoryThreshold * 1.2f) AlertSeverity.HIGH else AlertSeverity.MEDIUM,
                    message = "High memory usage: ${metrics.memoryUsage / 1024 / 1024} MB",
                    value = metrics.memoryUsage.toFloat(),
                    threshold = memoryThreshold.toFloat()
                )
            )
        }
        
        // Check CPU usage
        if (metrics.cpuUsage > cpuThreshold) {
            _performanceAlerts.tryEmit(
                PerformanceAlert(
                    type = AlertType.HIGH_CPU,
                    severity = if (metrics.cpuUsage > 95f) AlertSeverity.HIGH else AlertSeverity.MEDIUM,
                    message = "High CPU usage: ${metrics.cpuUsage.toInt()}%",
                    value = metrics.cpuUsage,
                    threshold = cpuThreshold
                )
            )
        }
        
        // Check sensor latency
        if (metrics.averageSensorLatency > 100) {
            _performanceAlerts.tryEmit(
                PerformanceAlert(
                    type = AlertType.SENSOR_LATENCY,
                    severity = AlertSeverity.MEDIUM,
                    message = "High sensor latency: ${metrics.averageSensorLatency} ms",
                    value = metrics.averageSensorLatency.toFloat(),
                    threshold = 100f
                )
            )
        }
    }
    
    private fun countDroppedFrames(): Int {
        return frameTimeBuffer.count { it > frameTimeThreshold }
    }
    
    private fun countSensorErrors(): Int {
        return preferences.getInt("sensor_errors", 0)
    }
    
    private fun getBatteryLevel(): Float {
        return try {
            // In production, would use BatteryManager API
            75f // Placeholder
        } catch (e: Exception) {
            0f
        }
    }
    
    private fun getThermalState(): ThermalState {
        return try {
            // In production, would use thermal monitoring APIs
            ThermalState.NORMAL
        } catch (e: Exception) {
            ThermalState.UNKNOWN
        }
    }
    
    /**
     * Record frame render time
     */
    fun recordFrameTime(frameTimeMs: Long) {
        frameTimeBuffer.offer(frameTimeMs)
        
        // Keep buffer limited
        while (frameTimeBuffer.size > 300) {
            frameTimeBuffer.poll()
        }
    }
    
    /**
     * Record sensor latency
     */
    fun recordSensorLatency(latencyMs: Long) {
        sensorLatencyBuffer.offer(latencyMs)
        
        // Keep buffer limited
        while (sensorLatencyBuffer.size > 100) {
            sensorLatencyBuffer.poll()
        }
    }
    
    /**
     * Record sensor error
     */
    fun recordSensorError() {
        val currentErrors = preferences.getInt("sensor_errors", 0)
        preferences.edit().putInt("sensor_errors", currentErrors + 1).apply()
    }
    
    /**
     * Record custom performance event
     */
    fun recordPerformanceEvent(event: PerformanceEvent) {
        scope.launch {
            try {
                // In production, would send to analytics service
                Log.d(TAG, "Performance event: ${event.type} - ${event.duration}ms")
            } catch (e: Exception) {
                Log.e(TAG, "Failed to record performance event", e)
            }
        }
    }
    
    /**
     * Measure execution time of a block
     */
    inline fun <T> measureOperation(name: String, operation: () -> T): T {
        val duration = measureTimeMillis {
            return operation()
        }
        
        recordPerformanceEvent(
            PerformanceEvent(
                type = name,
                duration = duration,
                timestamp = System.currentTimeMillis()
            )
        )
        
        return operation()
    }
    
    /**
     * Get performance summary
     */
    fun getPerformanceSummary(): PerformanceSummary {
        val metrics = _performanceMetrics.value ?: return PerformanceSummary()
        
        return PerformanceSummary(
            averageFps = metrics.fps,
            worstFps = calculateWorstFps(),
            averageMemory = metrics.memoryUsage,
            peakMemory = calculatePeakMemory(),
            averageCpu = metrics.cpuUsage,
            peakCpu = calculatePeakCpu(),
            totalDroppedFrames = metrics.droppedFrames,
            totalSensorErrors = metrics.sensorErrors,
            uptime = metrics.uptime,
            alertCount = getAlertCount()
        )
    }
    
    private fun calculateWorstFps(): Float {
        return if (frameTimeBuffer.isNotEmpty()) {
            val worstFrameTime = frameTimeBuffer.maxOrNull() ?: 0L
            if (worstFrameTime > 0) 1000f / worstFrameTime else 0f
        } else 0f
    }
    
    private fun calculatePeakMemory(): Long {
        return memoryUsageBuffer.maxOrNull() ?: 0L
    }
    
    private fun calculatePeakCpu(): Float {
        return cpuUsageBuffer.maxOrNull() ?: 0f
    }
    
    private fun getAlertCount(): Int {
        return preferences.getInt("alert_count", 0)
    }
    
    /**
     * Update performance thresholds
     */
    fun updateThresholds(thresholds: PerformanceThresholds) {
        frameTimeThreshold = thresholds.frameTimeThreshold
        memoryThreshold = thresholds.memoryThreshold
        cpuThreshold = thresholds.cpuThreshold
        
        preferences.edit().apply {
            putLong("frame_time_threshold", frameTimeThreshold)
            putLong("memory_threshold", memoryThreshold)
            putFloat("cpu_threshold", cpuThreshold)
            apply()
        }
        
        Log.i(TAG, "Performance thresholds updated")
    }
    
    /**
     * Stop monitoring
     */
    fun stopMonitoring() {
        isMonitoring = false
        scope.cancel()
        Log.i(TAG, "Performance monitoring stopped")
    }
    
    /**
     * Export performance data
     */
    suspend fun exportPerformanceData(): String = withContext(Dispatchers.IO) {
        return@withContext buildString {
            appendLine("Performance Data Export")
            appendLine("======================")
            appendLine("Export Time: ${java.util.Date()}")
            appendLine("Uptime: ${_performanceMetrics.value?.uptime} ms")
            appendLine()
            
            val summary = getPerformanceSummary()
            appendLine("Performance Summary:")
            appendLine("  Average FPS: ${summary.averageFps}")
            appendLine("  Worst FPS: ${summary.worstFps}")
            appendLine("  Average Memory: ${summary.averageMemory / 1024 / 1024} MB")
            appendLine("  Peak Memory: ${summary.peakMemory / 1024 / 1024} MB")
            appendLine("  Average CPU: ${summary.averageCpu}%")
            appendLine("  Peak CPU: ${summary.peakCpu}%")
            appendLine("  Dropped Frames: ${summary.totalDroppedFrames}")
            appendLine("  Sensor Errors: ${summary.totalSensorErrors}")
            appendLine("  Alert Count: ${summary.alertCount}")
            appendLine()
            
            appendLine("Device Information:")
            appendLine("  Manufacturer: ${Build.MANUFACTURER}")
            appendLine("  Model: ${Build.MODEL}")
            appendLine("  Android Version: ${Build.VERSION.RELEASE}")
            appendLine("  API Level: ${Build.VERSION.SDK_INT}")
            appendLine("  Available Processors: ${Runtime.getRuntime().availableProcessors()}")
            appendLine("  Max Memory: ${Runtime.getRuntime().maxMemory() / 1024 / 1024} MB")
        }
    }
    
    companion object {
        private const val TAG = "PerformanceMonitor"
    }
}

/**
 * Performance metrics data class
 */
data class PerformanceMetrics(
    val timestamp: Long,
    val uptime: Long,
    val fps: Float,
    val averageFrameTime: Long,
    val averageSensorLatency: Long,
    val memoryUsage: Long,
    val cpuUsage: Float,
    val droppedFrames: Int,
    val sensorErrors: Int,
    val batteryLevel: Float,
    val thermalState: ThermalState
)

/**
 * Performance alert data class
 */
data class PerformanceAlert(
    val type: AlertType,
    val severity: AlertSeverity,
    val message: String,
    val value: Float,
    val threshold: Float
)

/**
 * Performance event data class
 */
data class PerformanceEvent(
    val type: String,
    val duration: Long,
    val timestamp: Long
)

/**
 * Performance summary data class
 */
data class PerformanceSummary(
    val averageFps: Float = 0f,
    val worstFps: Float = 0f,
    val averageMemory: Long = 0L,
    val peakMemory: Long = 0L,
    val averageCpu: Float = 0f,
    val peakCpu: Float = 0f,
    val totalDroppedFrames: Int = 0,
    val totalSensorErrors: Int = 0,
    val uptime: Long = 0L,
    val alertCount: Int = 0
)

/**
 * Performance thresholds data class
 */
data class PerformanceThresholds(
    val frameTimeThreshold: Long = 33L,
    val memoryThreshold: Long = 100 * 1024 * 1024L,
    val cpuThreshold: Float = 80f
)

/**
 * Alert types enumeration
 */
enum class AlertType {
    LOW_FPS,
    HIGH_MEMORY,
    HIGH_CPU,
    SENSOR_LATENCY,
    BATTERY_LOW,
    THERMAL_THROTTLE
}

/**
 * Alert severity enumeration
 */
enum class AlertSeverity {
    LOW,
    MEDIUM,
    HIGH,
    CRITICAL
}

/**
 * Thermal state enumeration
 */
enum class ThermalState {
    UNKNOWN,
    NORMAL,
    WARM,
    HOT,
    SEVERE,
    EMERGENCY
}
