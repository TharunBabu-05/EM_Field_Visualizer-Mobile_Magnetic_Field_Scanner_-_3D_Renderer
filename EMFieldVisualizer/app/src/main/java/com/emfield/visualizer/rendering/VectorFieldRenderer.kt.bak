package com.emfield.visualizer.rendering

import android.content.Context
import android.opengl.GLES30
import android.util.Log
import com.emfield.visualizer.R
import com.emfield.visualizer.data.MagneticFieldData
import com.emfield.visualizer.data.Vector3
import java.nio.ByteBuffer
import java.nio.ByteOrder
import java.nio.FloatBuffer
import kotlin.math.max

/**
 * Renders magnetic field vectors as 3D arrows
 */
class VectorFieldRenderer(private val context: Context) {
    
    private var program = 0
    private var vertexBuffer: FloatBuffer? = null
    private var colorBuffer: FloatBuffer? = null
    private var normalBuffer: FloatBuffer? = null
    
    private var vertexCount = 0
    
    // Shader attribute/uniform locations
    private var positionHandle = 0
    private var colorHandle = 0
    private var normalHandle = 0
    private var mvpMatrixHandle = 0
    private var modelMatrixHandle = 0
    private var lightPosHandle = 0
    private var cameraPosHandle = 0
    
    init {
        setupShaders()
    }
    
    private fun setupShaders() {
        val vertexShaderCode = loadShaderFromResource(R.raw.vertex_shader)
        val fragmentShaderCode = loadShaderFromResource(R.raw.fragment_shader)
        
        val vertexShader = loadShader(GLES30.GL_VERTEX_SHADER, vertexShaderCode)
        val fragmentShader = loadShader(GLES30.GL_FRAGMENT_SHADER, fragmentShaderCode)
        
        program = GLES30.glCreateProgram().also {
            GLES30.glAttachShader(it, vertexShader)
            GLES30.glAttachShader(it, fragmentShader)
            GLES30.glLinkProgram(it)
            
            // Check linking status
            val linkStatus = IntArray(1)
            GLES30.glGetProgramiv(it, GLES30.GL_LINK_STATUS, linkStatus, 0)
            if (linkStatus[0] == 0) {
                val error = GLES30.glGetProgramInfoLog(it)
                GLES30.glDeleteProgram(it)
                throw RuntimeException("Error linking program: $error")
            }
        }
        
        // Get attribute locations
        positionHandle = GLES30.glGetAttribLocation(program, "aPosition")
        colorHandle = GLES30.glGetAttribLocation(program, "aColor")
        normalHandle = GLES30.glGetAttribLocation(program, "aNormal")
        
        // Get uniform locations
        mvpMatrixHandle = GLES30.glGetUniformLocation(program, "uMVPMatrix")
        modelMatrixHandle = GLES30.glGetUniformLocation(program, "uModelMatrix")
        lightPosHandle = GLES30.glGetUniformLocation(program, "uLightPos")
        cameraPosHandle = GLES30.glGetUniformLocation(program, "uCameraPos")
        
        Log.i(TAG, "Shaders compiled and linked successfully")
    }
    
    fun draw(
        mvpMatrix: FloatArray,
        modelMatrix: FloatArray,
        dataPoints: List<MagneticFieldData>,
        lightPos: FloatArray,
        cameraPos: FloatArray
    ) {
        if (dataPoints.isEmpty()) return
        
        // Generate arrow geometry for all data points
        generateArrowGeometry(dataPoints)
        
        if (vertexCount == 0) return
        
        // Use shader program
        GLES30.glUseProgram(program)
        
        // Set uniforms
        GLES30.glUniformMatrix4fv(mvpMatrixHandle, 1, false, mvpMatrix, 0)
        GLES30.glUniformMatrix4fv(modelMatrixHandle, 1, false, modelMatrix, 0)
        GLES30.glUniform3fv(lightPosHandle, 1, lightPos, 0)
        GLES30.glUniform3fv(cameraPosHandle, 1, cameraPos, 0)
        
        // Set vertex attributes
        vertexBuffer?.let { buffer ->
            buffer.position(0)
            GLES30.glEnableVertexAttribArray(positionHandle)
            GLES30.glVertexAttribPointer(
                positionHandle, 3, GLES30.GL_FLOAT, false, 0, buffer
            )
        }
        
        colorBuffer?.let { buffer ->
            buffer.position(0)
            GLES30.glEnableVertexAttribArray(colorHandle)
            GLES30.glVertexAttribPointer(
                colorHandle, 3, GLES30.GL_FLOAT, false, 0, buffer
            )
        }
        
        normalBuffer?.let { buffer ->
            buffer.position(0)
            GLES30.glEnableVertexAttribArray(normalHandle)
            GLES30.glVertexAttribPointer(
                normalHandle, 3, GLES30.GL_FLOAT, false, 0, buffer
            )
        }
        
        // Draw arrows
        GLES30.glDrawArrays(GLES30.GL_TRIANGLES, 0, vertexCount)
        
        // Disable vertex arrays
        GLES30.glDisableVertexAttribArray(positionHandle)
        GLES30.glDisableVertexAttribArray(colorHandle)
        GLES30.glDisableVertexAttribArray(normalHandle)
    }
    
    private fun generateArrowGeometry(dataPoints: List<MagneticFieldData>) {
        val vertices = mutableListOf<Float>()
        val colors = mutableListOf<Float>()
        val normals = mutableListOf<Float>()
        
        for (point in dataPoints) {
            val position = point.position
            val direction = point.direction()
            val magnitude = point.magnitude()
            
            // Skip if too weak
            if (magnitude < 1f) continue
            
            // Scale arrow length based on magnitude
            val length = (magnitude / 100f).coerceIn(0.05f, 0.3f)
            
            // Generate arrow geometry
            generateArrow(
                position,
                direction,
                length,
                magnitude,
                vertices,
                colors,
                normals
            )
        }
        
        // Convert to FloatBuffers
        vertexCount = vertices.size / 3
        
        vertexBuffer = ByteBuffer.allocateDirect(vertices.size * 4)
            .order(ByteOrder.nativeOrder())
            .asFloatBuffer()
            .apply {
                put(vertices.toFloatArray())
                position(0)
            }
        
        colorBuffer = ByteBuffer.allocateDirect(colors.size * 4)
            .order(ByteOrder.nativeOrder())
            .asFloatBuffer()
            .apply {
                put(colors.toFloatArray())
                position(0)
            }
        
        normalBuffer = ByteBuffer.allocateDirect(normals.size * 4)
            .order(ByteOrder.nativeOrder())
            .asFloatBuffer()
            .apply {
                put(normals.toFloatArray())
                position(0)
            }
    }
    
    private fun generateArrow(
        position: Vector3,
        direction: Vector3,
        length: Float,
        magnitude: Float,
        vertices: MutableList<Float>,
        colors: MutableList<Float>,
        normals: MutableList<Float>
    ) {
        val arrowEnd = position + (direction * length)
        val shaftRadius = 0.01f
        val headRadius = 0.03f
        val headLength = length * 0.3f
        
        // Color based on field strength (green -> yellow -> red)
        val color = getColorForMagnitude(magnitude)
        
        // Simplified arrow as a line with cone head
        // For performance, using simple triangles
        
        // Arrow shaft (cylinder approximated as triangles)
        val shaftEnd = position + (direction * (length - headLength))
        addCylinder(position, shaftEnd, shaftRadius, color, vertices, colors, normals)
        
        // Arrow head (cone)
        addCone(shaftEnd, arrowEnd, headRadius, color, vertices, colors, normals)
    }
    
    private fun addCylinder(
        start: Vector3,
        end: Vector3,
        radius: Float,
        color: Vector3,
        vertices: MutableList<Float>,
        colors: MutableList<Float>,
        normals: MutableList<Float>
    ) {
        // Simplified cylinder as 6-sided prism
        val segments = 6
        val direction = (end - start).normalized()
        
        // Get perpendicular vectors
        val right = if (kotlin.math.abs(direction.y) < 0.9f) {
            direction.cross(Vector3.UP).normalized()
        } else {
            direction.cross(Vector3.RIGHT).normalized()
        }
        val up = direction.cross(right).normalized()
        
        for (i in 0 until segments) {
            val angle1 = (i.toFloat() / segments) * 2f * Math.PI.toFloat()
            val angle2 = ((i + 1).toFloat() / segments) * 2f * Math.PI.toFloat()
            
            val cos1 = kotlin.math.cos(angle1)
            val sin1 = kotlin.math.sin(angle1)
            val cos2 = kotlin.math.cos(angle2)
            val sin2 = kotlin.math.sin(angle2)
            
            val offset1 = (right * cos1 * radius) + (up * sin1 * radius)
            val offset2 = (right * cos2 * radius) + (up * sin2 * radius)
            
            val v1 = start + offset1
            val v2 = start + offset2
            val v3 = end + offset1
            val v4 = end + offset2
            
            val normal = offset1.normalized()
            
            // Two triangles per segment
            addTriangle(v1, v2, v3, normal, color, vertices, colors, normals)
            addTriangle(v2, v4, v3, normal, color, vertices, colors, normals)
        }
    }
    
    private fun addCone(
        start: Vector3,
        tip: Vector3,
        radius: Float,
        color: Vector3,
        vertices: MutableList<Float>,
        colors: MutableList<Float>,
        normals: MutableList<Float>
    ) {
        val segments = 6
        val direction = (tip - start).normalized()
        
        val right = if (kotlin.math.abs(direction.y) < 0.9f) {
            direction.cross(Vector3.UP).normalized()
        } else {
            direction.cross(Vector3.RIGHT).normalized()
        }
        val up = direction.cross(right).normalized()
        
        for (i in 0 until segments) {
            val angle1 = (i.toFloat() / segments) * 2f * Math.PI.toFloat()
            val angle2 = ((i + 1).toFloat() / segments) * 2f * Math.PI.toFloat()
            
            val cos1 = kotlin.math.cos(angle1)
            val sin1 = kotlin.math.sin(angle1)
            val cos2 = kotlin.math.cos(angle2)
            val sin2 = kotlin.math.sin(angle2)
            
            val offset1 = (right * cos1 * radius) + (up * sin1 * radius)
            val offset2 = (right * cos2 * radius) + (up * sin2 * radius)
            
            val v1 = start + offset1
            val v2 = start + offset2
            
            val normal = ((v1 + v2) * 0.5f - start).normalized()
            
            addTriangle(v1, v2, tip, normal, color, vertices, colors, normals)
        }
    }
    
    private fun addTriangle(
        v1: Vector3, v2: Vector3, v3: Vector3,
        normal: Vector3,
        color: Vector3,
        vertices: MutableList<Float>,
        colors: MutableList<Float>,
        normals: MutableList<Float>
    ) {
        // Add vertices
        vertices.addAll(listOf(v1.x, v1.y, v1.z))
        vertices.addAll(listOf(v2.x, v2.y, v2.z))
        vertices.addAll(listOf(v3.x, v3.y, v3.z))
        
        // Add colors (same for all vertices)
        repeat(3) {
            colors.addAll(listOf(color.x, color.y, color.z))
        }
        
        // Add normals (same for all vertices)
        repeat(3) {
            normals.addAll(listOf(normal.x, normal.y, normal.z))
        }
    }
    
    private fun getColorForMagnitude(magnitude: Float): Vector3 {
        // Color gradient: green (weak) -> yellow (medium) -> red (strong)
        val normalized = (magnitude / 100f).coerceIn(0f, 1f)
        
        return when {
            normalized < 0.5f -> {
                // Green to yellow
                val t = normalized * 2f
                Vector3(t, 1f, 0f)
            }
            else -> {
                // Yellow to red
                val t = (normalized - 0.5f) * 2f
                Vector3(1f, 1f - t, 0f)
            }
        }
    }
    
    private fun loadShader(type: Int, shaderCode: String): Int {
        return GLES30.glCreateShader(type).also { shader ->
            GLES30.glShaderSource(shader, shaderCode)
            GLES30.glCompileShader(shader)
            
            val compileStatus = IntArray(1)
            GLES30.glGetShaderiv(shader, GLES30.GL_COMPILE_STATUS, compileStatus, 0)
            if (compileStatus[0] == 0) {
                val error = GLES30.glGetShaderInfoLog(shader)
                GLES30.glDeleteShader(shader)
                throw RuntimeException("Error compiling shader: $error")
            }
        }
    }
    
    private fun loadShaderFromResource(resourceId: Int): String {
        return context.resources.openRawResource(resourceId)
            .bufferedReader()
            .use { it.readText() }
    }
    
    fun cleanup() {
        if (program != 0) {
            GLES30.glDeleteProgram(program)
            program = 0
        }
    }
    
    companion object {
        private const val TAG = "VectorFieldRenderer"
    }
}
