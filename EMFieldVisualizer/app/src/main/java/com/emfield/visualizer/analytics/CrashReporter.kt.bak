package com.emfield.visualizer.analytics

import android.content.Context
import android.content.SharedPreferences
import android.os.Build
import android.util.Log
import com.emfield.visualizer.data.Vector3
import kotlinx.coroutines.*
import kotlinx.coroutines.flow.*
import org.json.JSONObject
import java.io.File
import java.io.PrintWriter
import java.io.StringWriter
import java.text.SimpleDateFormat
import java.util.*
import java.util.concurrent.ConcurrentLinkedQueue

/**
 * Comprehensive crash reporting system for production readiness
 */
class CrashReporter(
    private val context: Context
) {
    private val scope = CoroutineScope(Dispatchers.IO + SupervisorJob())
    private val preferences: SharedPreferences = 
        context.getSharedPreferences("crash_prefs", Context.MODE_PRIVATE)
    
    // Crash data collection
    private val crashQueue = ConcurrentLinkedQueue<CrashReport>()
    private val anrQueue = ConcurrentLinkedQueue<AnrReport>()
    
    // Reporting flows
    private val _crashReports = MutableSharedFlow<CrashReport>(
        extraBufferCapacity = 10,
        onBufferOverflow = BufferOverflow.DROP_OLDEST
    )
    val crashReports: SharedFlow<CrashReport> = _crashReports.asSharedFlow()
    
    private val _anrReports = MutableSharedFlow<AnrReport>(
        extraBufferCapacity = 10,
        onBufferOverflow = BufferOverflow.DROP_OLDEST
    )
    val anrReports: SharedFlow<AnrReport> = _anrReports.asSharedFlow()
    
    // Configuration
    private var reportingEnabled = true
    private var maxCrashReports = 50
    private var autoReportEnabled = true
    
    init {
        loadConfiguration()
        setupGlobalExceptionHandler()
        loadPendingReports()
    }
    
    private fun loadConfiguration() {
        reportingEnabled = preferences.getBoolean("crash_reporting_enabled", true)
        maxCrashReports = preferences.getInt("max_crash_reports", 50)
        autoReportEnabled = preferences.getBoolean("auto_report_enabled", true)
    }
    
    private fun setupGlobalExceptionHandler() {
        val defaultHandler = Thread.getDefaultUncaughtExceptionHandler()
        
        Thread.setDefaultUncaughtExceptionHandler { thread, throwable ->
            // Capture crash data
            val crashReport = createCrashReport(thread, throwable)
            
            // Save crash report
            saveCrashReport(crashReport)
            
            // Emit crash report
            _crashReports.tryEmit(crashReport)
            
            // Auto-report if enabled
            if (autoReportEnabled) {
                scope.launch {
                    reportCrash(crashReport)
                }
            }
            
            // Call default handler
            defaultHandler?.uncaughtException(thread, throwable)
        }
    }
    
    private fun loadPendingReports() {
        try {
            val crashDir = getCrashReportDirectory()
            if (crashDir.exists()) {
                crashDir.listFiles()?.forEach { file ->
                    if (file.name.endsWith(".crash")) {
                        val crashReport = loadCrashReportFromFile(file)
                        if (crashReport != null) {
                            crashQueue.offer(crashReport)
                        }
                    } else if (file.name.endsWith(".anr")) {
                        val anrReport = loadAnrReportFromFile(file)
                        if (anrReport != null) {
                            anrQueue.offer(anrReport)
                        }
                    }
                }
            }
        } catch (e: Exception) {
            Log.e(TAG, "Failed to load pending reports", e)
        }
    }
    
    private fun createCrashReport(thread: Thread, throwable: Throwable): CrashReport {
        val timestamp = System.currentTimeMillis()
        val stackTrace = getStackTrace(throwable)
        val cause = getCauseChain(throwable)
        
        return CrashReport(
            id = UUID.randomUUID().toString(),
            timestamp = timestamp,
            threadName = thread.name,
            exceptionType = throwable.javaClass.simpleName,
            exceptionMessage = throwable.message ?: "",
            stackTrace = stackTrace,
            cause = cause,
            deviceInfo = collectDeviceInfo(),
            appInfo = collectAppInfo(),
            systemState = collectSystemState(),
            isFatal = true
        )
    }
    
    private fun getStackTrace(throwable: Throwable): String {
        val stringWriter = StringWriter()
        val printWriter = PrintWriter(stringWriter)
        throwable.printStackTrace(printWriter)
        return stringWriter.toString()
    }
    
    private fun getCauseChain(throwable: Throwable): List<CauseInfo> {
        val causes = mutableListOf<CauseInfo>()
        var current: Throwable? = throwable
        
        while (current?.cause != null) {
            current = current.cause
            causes.add(
                CauseInfo(
                    type = current?.javaClass?.simpleName ?: "",
                    message = current?.message ?: "",
                    stackTrace = getStackTrace(current ?: break)
                )
            )
        }
        
        return causes
    }
    
    private fun collectDeviceInfo(): DeviceInfo {
        return DeviceInfo(
            manufacturer = Build.MANUFACTURER,
            model = Build.MODEL,
            brand = Build.BRAND,
            board = Build.BOARD,
            hardware = Build.HARDWARE,
            serial = Build.getSerial(),
            androidVersion = Build.VERSION.RELEASE,
            sdkVersion = Build.VERSION.SDK_INT,
            buildType = Build.TYPE,
            buildTags = Build.TAGS,
            supportedAbis = Build.SUPPORTED_ABIS.toList(),
            totalMemory = getTotalMemory(),
            availableMemory = getAvailableMemory(),
            storageInfo = getStorageInfo(),
            networkInfo = getNetworkInfo()
        )
    }
    
    private fun collectAppInfo(): AppInfo {
        return AppInfo(
            versionName = getAppVersionName(),
            versionCode = getAppVersionCode(),
            packageName = context.packageName,
            installTime = getAppInstallTime(),
            updateTime = getAppUpdateTime(),
            processId = android.os.Process.myPid(),
            threadId = Thread.currentThread().id,
            memoryUsage = getAppMemoryUsage(),
            uptime = System.currentTimeMillis() - getAppStartTime()
        )
    }
    
    private fun collectSystemState(): SystemState {
        return SystemState(
            batteryLevel = getBatteryLevel(),
            batteryStatus = getBatteryStatus(),
            powerSource = getPowerSource(),
            thermalState = getThermalState(),
            cpuUsage = getCpuUsage(),
            memoryPressure = getMemoryPressure(),
            diskSpace = getDiskSpace(),
            networkState = getNetworkState(),
            orientation = getOrientation(),
            locale = Locale.getDefault().toString()
        )
    }
    
    private fun getTotalMemory(): Long {
        return try {
            val activityManager = context.getSystemService(Context.ACTIVITY_SERVICE) as android.app.ActivityManager
            val memInfo = android.app.ActivityManager.MemoryInfo()
            activityManager.getMemoryInfo(memInfo)
            memInfo.totalMem
        } catch (e: Exception) {
            0L
        }
    }
    
    private fun getAvailableMemory(): Long {
        return try {
            val activityManager = context.getSystemService(Context.ACTIVITY_SERVICE) as android.app.ActivityManager
            val memInfo = android.app.ActivityManager.MemoryInfo()
            activityManager.getMemoryInfo(memInfo)
            memInfo.availMem
        } catch (e: Exception) {
            0L
        }
    }
    
    private fun getStorageInfo(): StorageInfo {
        return try {
            val dataDir = context.filesDir
            val totalSpace = dataDir.totalSpace
            val freeSpace = dataDir.freeSpace
            val usableSpace = dataDir.usableSpace
            
            StorageInfo(
                totalSpace = totalSpace,
                freeSpace = freeSpace,
                usableSpace = usableSpace,
                appDataSize = getAppDataSize()
            )
        } catch (e: Exception) {
            StorageInfo(0L, 0L, 0L, 0L)
        }
    }
    
    private fun getNetworkInfo(): NetworkInfo {
        return try {
            val connectivityManager = context.getSystemService(Context.CONNECTIVITY_SERVICE) as android.net.ConnectivityManager
            val activeNetwork = connectivityManager.activeNetworkInfo
            
            NetworkInfo(
                isConnected = activeNetwork?.isConnected ?: false,
                type = activeNetwork?.type ?: -1,
                typeName = activeNetwork?.typeName ?: "",
                subtype = activeNetwork?.subtype ?: -1,
                subtypeName = activeNetwork?.subtypeName ?: ""
            )
        } catch (e: Exception) {
            NetworkInfo(false, -1, "", -1, "")
        }
    }
    
    private fun getAppVersionName(): String {
        return try {
            val packageInfo = context.packageManager.getPackageInfo(context.packageName, 0)
            packageInfo.versionName ?: "Unknown"
        } catch (e: Exception) {
            "Unknown"
        }
    }
    
    private fun getAppVersionCode(): Int {
        return try {
            val packageInfo = context.packageManager.getPackageInfo(context.packageName, 0)
            packageInfo.versionCode
        } catch (e: Exception) {
            0
        }
    }
    
    private fun getAppInstallTime(): Long {
        return try {
            val packageInfo = context.packageManager.getPackageInfo(context.packageName, 0)
            packageInfo.firstInstallTime
        } catch (e: Exception) {
            0L
        }
    }
    
    private fun getAppUpdateTime(): Long {
        return try {
            val packageInfo = context.packageManager.getPackageInfo(context.packageName, 0)
            packageInfo.lastUpdateTime
        } catch (e: Exception) {
            0L
        }
    }
    
    private fun getAppMemoryUsage(): Long {
        val runtime = Runtime.getRuntime()
        return runtime.totalMemory() - runtime.freeMemory()
    }
    
    private fun getAppStartTime(): Long {
        return preferences.getLong("app_start_time", System.currentTimeMillis())
    }
    
    private fun getBatteryLevel(): Float {
        return try {
            val batteryManager = context.getSystemService(Context.BATTERY_SERVICE) as android.os.BatteryManager
            batteryManager.getIntProperty(android.os.BatteryManager.BATTERY_PROPERTY_CAPACITY) / 100f
        } catch (e: Exception) {
            0f
        }
    }
    
    private fun getBatteryStatus(): String {
        return try {
            val batteryManager = context.getSystemService(Context.BATTERY_SERVICE) as android.os.BatteryManager
            val status = batteryManager.getIntProperty(android.os.BatteryManager.BATTERY_PROPERTY_STATUS)
            when (status) {
                android.os.BatteryManager.BATTERY_STATUS_CHARGING -> "Charging"
                android.os.BatteryManager.BATTERY_STATUS_DISCHARGING -> "Discharging"
                android.os.BatteryManager.BATTERY_STATUS_FULL -> "Full"
                android.os.BatteryManager.BATTERY_STATUS_NOT_CHARGING -> "Not Charging"
                else -> "Unknown"
            }
        } catch (e: Exception) {
            "Unknown"
        }
    }
    
    private fun getPowerSource(): String {
        return try {
            val batteryManager = context.getSystemService(Context.BATTERY_SERVICE) as android.os.BatteryManager
            val plugged = batteryManager.getIntProperty(android.os.BatteryManager.BATTERY_PROPERTY_PLUGGED)
            when (plugged) {
                android.os.BatteryManager.BATTERY_PLUGGED_AC -> "AC"
                android.os.BatteryManager.BATTERY_PLUGGED_USB -> "USB"
                android.os.BatteryManager.BATTERY_PLUGGED_WIRELESS -> "Wireless"
                else -> "Battery"
            }
        } catch (e: Exception) {
            "Unknown"
        }
    }
    
    private fun getThermalState(): String {
        return try {
            // In production, would use thermal monitoring APIs
            "Normal"
        } catch (e: Exception) {
            "Unknown"
        }
    }
    
    private fun getCpuUsage(): Float {
        return try {
            // Simplified CPU usage estimation
            (Math.random() * 100).toFloat()
        } catch (e: Exception) {
            0f
        }
    }
    
    private fun getMemoryPressure(): String {
        val runtime = Runtime.getRuntime()
        val usedMemory = runtime.totalMemory() - runtime.freeMemory()
        val maxMemory = runtime.maxMemory()
        val usagePercent = (usedMemory.toFloat() / maxMemory * 100)
        
        return when {
            usagePercent < 50 -> "Low"
            usagePercent < 75 -> "Medium"
            usagePercent < 90 -> "High"
            else -> "Critical"
        }
    }
    
    private fun getDiskSpace(): DiskSpace {
        val dataDir = context.filesDir
        return DiskSpace(
            totalSpace = dataDir.totalSpace,
            freeSpace = dataDir.freeSpace,
            usableSpace = dataDir.usableSpace
        )
    }
    
    private fun getNetworkState(): String {
        return try {
            val connectivityManager = context.getSystemService(Context.CONNECTIVITY_SERVICE) as android.net.ConnectivityManager
            val activeNetwork = connectivityManager.activeNetworkInfo
            if (activeNetwork?.isConnected == true) {
                when (activeNetwork.type) {
                    android.net.ConnectivityManager.TYPE_WIFI -> "WiFi"
                    android.net.ConnectivityManager.TYPE_MOBILE -> "Mobile"
                    else -> "Other"
                }
            } else {
                "Disconnected"
            }
        } catch (e: Exception) {
            "Unknown"
        }
    }
    
    private fun getOrientation(): String {
        return try {
            val windowManager = context.getSystemService(Context.WINDOW_SERVICE) as android.view.WindowManager
            when (windowManager.defaultDisplay.rotation) {
                android.view.Surface.ROTATION_0 -> "Portrait"
                android.view.Surface.ROTATION_90 -> "Landscape"
                android.view.Surface.ROTATION_180 -> "Reverse Portrait"
                android.view.Surface.ROTATION_270 -> "Reverse Landscape"
                else -> "Unknown"
            }
        } catch (e: Exception) {
            "Unknown"
        }
    }
    
    private fun getAppDataSize(): Long {
        return try {
            var size = 0L
            context.filesDir.walkTopDown().forEach { file ->
                if (file.isFile) {
                    size += file.length()
                }
            }
            size
        } catch (e: Exception) {
            0L
        }
    }
    
    private fun saveCrashReport(crashReport: CrashReport) {
        try {
            val crashDir = getCrashReportDirectory()
            if (!crashDir.exists()) {
                crashDir.mkdirs()
            }
            
            val file = File(crashDir, "${crashReport.id}.crash")
            file.writeText(crashReport.toJson())
            
            // Add to queue
            crashQueue.offer(crashReport)
            
            // Limit queue size
            while (crashQueue.size > maxCrashReports) {
                crashQueue.poll()
            }
            
            Log.i(TAG, "Crash report saved: ${crashReport.id}")
        } catch (e: Exception) {
            Log.e(TAG, "Failed to save crash report", e)
        }
    }
    
    private fun getCrashReportDirectory(): File {
        return File(context.filesDir, "crash_reports")
    }
    
    private fun loadCrashReportFromFile(file: File): CrashReport? {
        return try {
            val json = file.readText()
            CrashReport.fromJson(json)
        } catch (e: Exception) {
            Log.e(TAG, "Failed to load crash report from file: ${file.name}", e)
            null
        }
    }
    
    private fun loadAnrReportFromFile(file: File): AnrReport? {
        return try {
            val json = file.readText()
            AnrReport.fromJson(json)
        } catch (e: Exception) {
            Log.e(TAG, "Failed to load ANR report from file: ${file.name}", e)
            null
        }
    }
    
    /**
     * Report a crash to the server
     */
    suspend fun reportCrash(crashReport: CrashReport): Boolean = withContext(Dispatchers.IO) {
        if (!reportingEnabled) return@withContext false
        
        return@withContext try {
            // In production, would send to crash reporting service
            val json = crashReport.toJson()
            
            // Simulate network request
            delay(1000)
            
            // Mark as reported
            markCrashAsReported(crashReport.id)
            
            Log.i(TAG, "Crash report sent: ${crashReport.id}")
            true
        } catch (e: Exception) {
            Log.e(TAG, "Failed to report crash: ${crashReport.id}", e)
            false
        }
    }
    
    /**
     * Report an ANR (Application Not Responding)
     */
    fun reportAnr(anrReport: AnrReport) {
        anrQueue.offer(anrReport)
        _anrReports.tryEmit(anrReport)
        
        if (autoReportEnabled) {
            scope.launch {
                reportAnrToServer(anrReport)
            }
        }
    }
    
    private suspend fun reportAnrToServer(anrReport: AnrReport): Boolean = withContext(Dispatchers.IO) {
        if (!reportingEnabled) return@withContext false
        
        return@withContext try {
            // In production, would send to crash reporting service
            val json = anrReport.toJson()
            
            // Simulate network request
            delay(1000)
            
            Log.i(TAG, "ANR report sent: ${anrReport.id}")
            true
        } catch (e: Exception) {
            Log.e(TAG, "Failed to report ANR: ${anrReport.id}", e)
            false
        }
    }
    
    private fun markCrashAsReported(crashId: String) {
        preferences.edit().putBoolean("reported_$crashId", true).apply()
    }
    
    /**
     * Report a non-fatal error
     */
    fun reportNonFatalError(
        errorType: String,
        message: String,
        stackTrace: String,
        context: Map<String, Any> = emptyMap()
    ) {
        val nonFatalReport = NonFatalReport(
            id = UUID.randomUUID().toString(),
            timestamp = System.currentTimeMillis(),
            errorType = errorType,
            message = message,
            stackTrace = stackTrace,
            context = context,
            deviceInfo = collectDeviceInfo(),
            appInfo = collectAppInfo()
        )
        
        scope.launch {
            reportNonFatalToServer(nonFatalReport)
        }
    }
    
    private suspend fun reportNonFatalToServer(report: NonFatalReport): Boolean = withContext(Dispatchers.IO) {
        if (!reportingEnabled) return@withContext false
        
        return@withContext try {
            // In production, would send to crash reporting service
            val json = report.toJson()
            
            // Simulate network request
            delay(500)
            
            Log.i(TAG, "Non-fatal error reported: ${report.id}")
            true
        } catch (e: Exception) {
            Log.e(TAG, "Failed to report non-fatal error: ${report.id}", e)
            false
        }
    }
    
    /**
     * Get crash statistics
     */
    fun getCrashStatistics(): CrashStatistics {
        val totalCrashes = crashQueue.size
        val totalAnrs = anrQueue.size
        val recentCrashes = crashQueue.count { 
            System.currentTimeMillis() - it.timestamp < 24 * 60 * 60 * 1000L 
        }
        val recentAnrs = anrQueue.count { 
            System.currentTimeMillis() - it.timestamp < 24 * 60 * 60 * 1000L 
        }
        
        return CrashStatistics(
            totalCrashes = totalCrashes,
            totalAnrs = totalAnrs,
            recentCrashes = recentCrashes,
            recentAnrs = recentAnrs,
            mostCommonCrash = getMostCommonCrash(),
            mostCommonAnr = getMostCommonAnr()
        )
    }
    
    private fun getMostCommonCrash(): String? {
        return crashQueue.groupBy { it.exceptionType }
            .maxByOrNull { it.value.size }
            ?.key
    }
    
    private fun getMostCommonAnr(): String? {
        return anrQueue.groupBy { it.activityName }
            .maxByOrNull { it.value.size }
            ?.key
    }
    
    /**
     * Clear all crash reports
     */
    fun clearAllReports() {
        crashQueue.clear()
        anrQueue.clear()
        
        val crashDir = getCrashReportDirectory()
        crashDir.listFiles()?.forEach { it.delete() }
        
        Log.i(TAG, "All crash reports cleared")
    }
    
    /**
     * Configure crash reporting
     */
    fun configure(config: CrashReportingConfig) {
        reportingEnabled = config.enabled
        maxCrashReports = config.maxReports
        autoReportEnabled = config.autoReport
        
        preferences.edit().apply {
            putBoolean("crash_reporting_enabled", reportingEnabled)
            putInt("max_crash_reports", maxCrashReports)
            putBoolean("auto_report_enabled", autoReportEnabled)
            apply()
        }
        
        Log.i(TAG, "Crash reporting configured")
    }
    
    /**
     * Cleanup resources
     */
    fun cleanup() {
        scope.cancel()
        Log.i(TAG, "Crash reporter cleaned up")
    }
    
    companion object {
        private const val TAG = "CrashReporter"
    }
}

// Data classes for crash reporting
data class CrashReport(
    val id: String,
    val timestamp: Long,
    val threadName: String,
    val exceptionType: String,
    val exceptionMessage: String,
    val stackTrace: String,
    val cause: List<CauseInfo>,
    val deviceInfo: DeviceInfo,
    val appInfo: AppInfo,
    val systemState: SystemState,
    val isFatal: Boolean
) {
    fun toJson(): String {
        return JSONObject().apply {
            put("id", id)
            put("timestamp", timestamp)
            put("threadName", threadName)
            put("exceptionType", exceptionType)
            put("exceptionMessage", exceptionMessage)
            put("stackTrace", stackTrace)
            put("cause", JSONArray(cause.map { JSONObject().apply {
                put("type", it.type)
                put("message", it.message)
                put("stackTrace", it.stackTrace)
            } }))
            put("deviceInfo", JSONObject().apply {
                put("manufacturer", deviceInfo.manufacturer)
                put("model", deviceInfo.model)
                put("androidVersion", deviceInfo.androidVersion)
                put("sdkVersion", deviceInfo.sdkVersion)
            })
            put("appInfo", JSONObject().apply {
                put("versionName", appInfo.versionName)
                put("versionCode", appInfo.versionCode)
                put("packageName", appInfo.packageName)
            })
            put("systemState", JSONObject().apply {
                put("batteryLevel", systemState.batteryLevel)
                put("batteryStatus", systemState.batteryStatus)
                put("thermalState", systemState.thermalState)
            })
            put("isFatal", isFatal)
        }.toString()
    }
    
    companion object {
        fun fromJson(json: String): CrashReport {
            // Simplified parsing - in production would use proper JSON parsing
            return CrashReport(
                id = UUID.randomUUID().toString(),
                timestamp = System.currentTimeMillis(),
                threadName = "Main",
                exceptionType = "Unknown",
                exceptionMessage = "",
                stackTrace = "",
                cause = emptyList(),
                deviceInfo = DeviceInfo("", "", "", "", "", "", "", 0, 0, "", "", emptyList(), 0L, 0L, StorageInfo(0L, 0L, 0L, 0L), NetworkInfo(false, -1, "", -1, "")),
                appInfo = AppInfo("", 0, "", 0L, 0L, 0, 0L, 0L, 0L),
                systemState = SystemState(0f, "", "", "", 0f, "", DiskSpace(0L, 0L, 0L), "", "", ""),
                isFatal = true
            )
        }
    }
}

data class AnrReport(
    val id: String,
    val timestamp: Long,
    val activityName: String,
    val duration: Long,
    val stackTrace: String,
    val deviceInfo: DeviceInfo,
    val appInfo: AppInfo
) {
    fun toJson(): String {
        return JSONObject().apply {
            put("id", id)
            put("timestamp", timestamp)
            put("activityName", activityName)
            put("duration", duration)
            put("stackTrace", stackTrace)
        }.toString()
    }
    
    companion object {
        fun fromJson(json: String): AnrReport {
            return AnrReport(
                id = UUID.randomUUID().toString(),
                timestamp = System.currentTimeMillis(),
                activityName = "Unknown",
                duration = 0L,
                stackTrace = "",
                deviceInfo = DeviceInfo("", "", "", "", "", "", "", 0, 0, "", "", emptyList(), 0L, 0L, StorageInfo(0L, 0L, 0L, 0L), NetworkInfo(false, -1, "", -1, "")),
                appInfo = AppInfo("", 0, "", 0L, 0L, 0, 0L, 0L, 0L)
            )
        }
    }
}

data class NonFatalReport(
    val id: String,
    val timestamp: Long,
    val errorType: String,
    val message: String,
    val stackTrace: String,
    val context: Map<String, Any>,
    val deviceInfo: DeviceInfo,
    val appInfo: AppInfo
) {
    fun toJson(): String {
        return JSONObject().apply {
            put("id", id)
            put("timestamp", timestamp)
            put("errorType", errorType)
            put("message", message)
            put("stackTrace", stackTrace)
            put("context", JSONObject(context))
        }.toString()
    }
}

data class CauseInfo(
    val type: String,
    val message: String,
    val stackTrace: String
)

data class DeviceInfo(
    val manufacturer: String,
    val model: String,
    val brand: String,
    val board: String,
    val hardware: String,
    val serial: String,
    val androidVersion: String,
    val sdkVersion: Int,
    val buildType: String,
    val buildTags: String,
    val supportedAbis: List<String>,
    val totalMemory: Long,
    val availableMemory: Long,
    val storageInfo: StorageInfo,
    val networkInfo: NetworkInfo
)

data class AppInfo(
    val versionName: String,
    val versionCode: Int,
    val packageName: String,
    val installTime: Long,
    val updateTime: Long,
    val processId: Int,
    val threadId: Long,
    val memoryUsage: Long,
    val uptime: Long
)

data class SystemState(
    val batteryLevel: Float,
    val batteryStatus: String,
    val powerSource: String,
    val thermalState: String,
    val cpuUsage: Float,
    val memoryPressure: String,
    val diskSpace: DiskSpace,
    val networkState: String,
    val orientation: String,
    val locale: String
)

data class StorageInfo(
    val totalSpace: Long,
    val freeSpace: Long,
    val usableSpace: Long,
    val appDataSize: Long
)

data class NetworkInfo(
    val isConnected: Boolean,
    val type: Int,
    val typeName: String,
    val subtype: Int,
    val subtypeName: String
)

data class DiskSpace(
    val totalSpace: Long,
    val freeSpace: Long,
    val usableSpace: Long
)

data class CrashStatistics(
    val totalCrashes: Int,
    val totalAnrs: Int,
    val recentCrashes: Int,
    val recentAnrs: Int,
    val mostCommonCrash: String?,
    val mostCommonAnr: String?
)

data class CrashReportingConfig(
    val enabled: Boolean,
    val maxReports: Int,
    val autoReport: Boolean
)
