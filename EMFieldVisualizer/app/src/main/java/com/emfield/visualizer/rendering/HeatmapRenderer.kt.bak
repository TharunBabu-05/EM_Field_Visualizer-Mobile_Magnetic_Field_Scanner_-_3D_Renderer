package com.emfield.visualizer.rendering

import android.content.Context
import android.opengl.GLES30
import android.opengl.Matrix
import android.util.Log
import com.emfield.visualizer.R
import com.emfield.visualizer.data.MagneticFieldData
import com.emfield.visualizer.data.Vector3
import java.nio.ByteBuffer
import java.nio.ByteOrder
import java.nio.FloatBuffer
import kotlin.math.max
import kotlin.math.min

/**
 * Renders magnetic field strength as a colored heatmap overlay
 */
class HeatmapRenderer(private val context: Context) {
    
    private var program = 0
    private var vertexBuffer: FloatBuffer? = null
    private var colorBuffer: FloatBuffer? = null
    private var texCoordBuffer: FloatBuffer? = null
    
    private var vertexCount = 0
    private var textureId = 0
    
    // Shader attribute/uniform locations
    private var positionHandle = 0
    private var colorHandle = 0
    private var texCoordHandle = 0
    private var mvpMatrixHandle = 0
    private var textureHandle = 0
    private var minValueHandle = 0
    private var maxValueHandle = 0
    
    // Heatmap parameters
    private var gridResolution = 20
    private var minValue = 0f
    private var maxValue = 100f
    
    init {
        setupShaders()
        generateTexture()
    }
    
    private fun setupShaders() {
        val vertexShaderCode = """
            #version 300 es
            layout (location = 0) in vec3 aPosition;
            layout (location = 1) in vec2 aTexCoord;
            
            uniform mat4 uMVPMatrix;
            
            out vec2 vTexCoord;
            
            void main() {
                gl_Position = uMVPMatrix * vec4(aPosition, 1.0);
                vTexCoord = aTexCoord;
            }
        """.trimIndent()
        
        val fragmentShaderCode = """
            #version 300 es
            precision mediump float;
            
            in vec2 vTexCoord;
            uniform sampler2D uTexture;
            uniform float uMinValue;
            uniform float uMaxValue;
            
            out vec4 fragColor;
            
            vec3 heatmapColor(float value) {
                float normalized = (value - uMinValue) / (uMaxValue - uMinValue);
                normalized = clamp(normalized, 0.0, 1.0);
                
                // Color gradient: blue -> cyan -> green -> yellow -> red
                if (normalized < 0.25) {
                    float t = normalized * 4.0;
                    return mix(vec3(0.0, 0.0, 1.0), vec3(0.0, 1.0, 1.0), t);
                } else if (normalized < 0.5) {
                    float t = (normalized - 0.25) * 4.0;
                    return mix(vec3(0.0, 1.0, 1.0), vec3(0.0, 1.0, 0.0), t);
                } else if (normalized < 0.75) {
                    float t = (normalized - 0.5) * 4.0;
                    return mix(vec3(0.0, 1.0, 0.0), vec3(1.0, 1.0, 0.0), t);
                } else {
                    float t = (normalized - 0.75) * 4.0;
                    return mix(vec3(1.0, 1.0, 0.0), vec3(1.0, 0.0, 0.0), t);
                }
            }
            
            void main() {
                float value = texture(uTexture, vTexCoord).r;
                vec3 color = heatmapColor(value);
                fragColor = vec4(color, 0.8);
            }
        """.trimIndent()
        
        val vertexShader = loadShader(GLES30.GL_VERTEX_SHADER, vertexShaderCode)
        val fragmentShader = loadShader(GLES30.GL_FRAGMENT_SHADER, fragmentShaderCode)
        
        program = GLES30.glCreateProgram().also {
            GLES30.glAttachShader(it, vertexShader)
            GLES30.glAttachShader(it, fragmentShader)
            GLES30.glLinkProgram(it)
            
            val linkStatus = IntArray(1)
            GLES30.glGetProgramiv(it, GLES30.GL_LINK_STATUS, linkStatus, 0)
            if (linkStatus[0] == 0) {
                val error = GLES30.glGetProgramInfoLog(it)
                GLES30.glDeleteProgram(it)
                throw RuntimeException("Error linking program: $error")
            }
        }
        
        positionHandle = GLES30.glGetAttribLocation(program, "aPosition")
        texCoordHandle = GLES30.glGetAttribLocation(program, "aTexCoord")
        mvpMatrixHandle = GLES30.glGetUniformLocation(program, "uMVPMatrix")
        textureHandle = GLES30.glGetUniformLocation(program, "uTexture")
        minValueHandle = GLES30.glGetUniformLocation(program, "uMinValue")
        maxValueHandle = GLES30.glGetUniformLocation(program, "uMaxValue")
        
        Log.i(TAG, "Heatmap shaders compiled successfully")
    }
    
    private fun generateTexture() {
        val textureIds = IntArray(1)
        GLES30.glGenTextures(1, textureIds, 0)
        textureId = textureIds[0]
        
        GLES30.glBindTexture(GLES30.GL_TEXTURE_2D, textureId)
        
        // Set texture parameters
        GLES30.glTexParameteri(GLES30.GL_TEXTURE_2D, GLES30.GL_TEXTURE_MIN_FILTER, GLES30.GL_LINEAR)
        GLES30.glTexParameteri(GLES30.GL_TEXTURE_2D, GLES30.GL_TEXTURE_MAG_FILTER, GLES30.GL_LINEAR)
        GLES30.glTexParameteri(GLES30.GL_TEXTURE_2D, GLES30.GL_TEXTURE_WRAP_S, GLES30.GL_CLAMP_TO_EDGE)
        GLES30.glTexParameteri(GLES30.GL_TEXTURE_2D, GLES30.GL_TEXTURE_WRAP_T, GLES30.GL_CLAMP_TO_EDGE)
    }
    
    fun draw(
        mvpMatrix: FloatArray,
        dataPoints: List<MagneticFieldData>,
        boundingBox: Pair<Vector3, Vector3>?
    ) {
        if (dataPoints.isEmpty() || boundingBox == null) return
        
        // Generate heatmap geometry and texture data
        generateHeatmapGeometry(dataPoints, boundingBox)
        
        if (vertexCount == 0) return
        
        // Enable blending for transparency
        GLES30.glEnable(GLES30.GL_BLEND)
        GLES30.glBlendFunc(GLES30.GL_SRC_ALPHA, GLES30.GL_ONE_MINUS_SRC_ALPHA)
        
        GLES30.glUseProgram(program)
        
        // Set uniforms
        GLES30.glUniformMatrix4fv(mvpMatrixHandle, 1, false, mvpMatrix, 0)
        GLES30.glUniform1i(textureHandle, 0)
        GLES30.glUniform1f(minValueHandle, minValue)
        GLES30.glUniform1f(maxValueHandle, maxValue)
        
        // Bind texture
        GLES30.glActiveTexture(GLES30.GL_TEXTURE0)
        GLES30.glBindTexture(GLES30.GL_TEXTURE_2D, textureId)
        
        // Set vertex attributes
        vertexBuffer?.let { buffer ->
            buffer.position(0)
            GLES30.glEnableVertexAttribArray(positionHandle)
            GLES30.glVertexAttribPointer(
                positionHandle, 3, GLES30.GL_FLOAT, false, 0, buffer
            )
        }
        
        texCoordBuffer?.let { buffer ->
            buffer.position(0)
            GLES30.glEnableVertexAttribArray(texCoordHandle)
            GLES30.glVertexAttribPointer(
                texCoordHandle, 2, GLES30.GL_FLOAT, false, 0, buffer
            )
        }
        
        // Draw heatmap
        GLES30.glDrawArrays(GLES30.GL_TRIANGLES, 0, vertexCount)
        
        // Disable vertex arrays
        GLES30.glDisableVertexAttribArray(positionHandle)
        GLES30.glDisableVertexAttribArray(texCoordHandle)
        
        // Disable blending
        GLES30.glDisable(GLES30.GL_BLEND)
    }
    
    private fun generateHeatmapGeometry(
        dataPoints: List<MagneticFieldData>,
        boundingBox: Pair<Vector3, Vector3>
    ) {
        val (minBound, maxBound) = boundingBox
        val size = maxBound - minBound
        
        // Create grid
        val gridSize = gridResolution
        val cellSizeX = size.x / gridSize
        val cellSizeZ = size.z / gridSize
        
        val vertices = mutableListOf<Float>()
        val texCoords = mutableListOf<Float>()
        val fieldData = Array(gridSize + 1) { FloatArray(gridSize + 1) }
        
        // Calculate field values at grid points using interpolation
        for (i in 0..gridSize) {
            for (j in 0..gridSize) {
                val x = minBound.x + i * cellSizeX
                val z = minBound.z + j * cellSizeZ
                val y = minBound.y + size.y * 0.5f // Center height
                
                val position = Vector3(x, y, z)
                val fieldValue = interpolateFieldValue(position, dataPoints)
                fieldData[i][j] = fieldValue
                
                // Update min/max values
                minValue = min(minValue, fieldValue)
                maxValue = max(maxValue, fieldValue)
            }
        }
        
        // Generate geometry as a grid of quads (2 triangles each)
        for (i in 0 until gridSize) {
            for (j in 0 until gridSize) {
                val x1 = minBound.x + i * cellSizeX
                val x2 = minBound.x + (i + 1) * cellSizeX
                val z1 = minBound.z + j * cellSizeZ
                val z2 = minBound.z + (j + 1) * cellSizeZ
                val y = minBound.y + size.y * 0.5f
                
                // First triangle
                vertices.addAll(listOf(x1, y, z1))
                vertices.addAll(listOf(x2, y, z1))
                vertices.addAll(listOf(x1, y, z2))
                
                texCoords.addAll(listOf(i.toFloat() / gridSize, j.toFloat() / gridSize))
                texCoords.addAll(listOf((i + 1).toFloat() / gridSize, j.toFloat() / gridSize))
                texCoords.addAll(listOf(i.toFloat() / gridSize, (j + 1).toFloat() / gridSize))
                
                // Second triangle
                vertices.addAll(listOf(x2, y, z1))
                vertices.addAll(listOf(x2, y, z2))
                vertices.addAll(listOf(x1, y, z2))
                
                texCoords.addAll(listOf((i + 1).toFloat() / gridSize, j.toFloat() / gridSize))
                texCoords.addAll(listOf((i + 1).toFloat() / gridSize, (j + 1).toFloat() / gridSize))
                texCoords.addAll(listOf(i.toFloat() / gridSize, (j + 1).toFloat() / gridSize))
            }
        }
        
        // Convert to FloatBuffers
        vertexCount = vertices.size / 3
        
        vertexBuffer = ByteBuffer.allocateDirect(vertices.size * 4)
            .order(ByteOrder.nativeOrder())
            .asFloatBuffer()
            .apply {
                put(vertices.toFloatArray())
                position(0)
            }
        
        texCoordBuffer = ByteBuffer.allocateDirect(texCoords.size * 4)
            .order(ByteOrder.nativeOrder())
            .asFloatBuffer()
            .apply {
                put(texCoords.toFloatArray())
                position(0)
            }
        
        // Update texture with field data
        updateTexture(fieldData)
    }
    
    private fun interpolateFieldValue(position: Vector3, dataPoints: List<MagneticFieldData>): Float {
        if (dataPoints.isEmpty()) return 0f
        
        // Simple inverse distance weighted interpolation
        var weightedSum = 0f
        var totalWeight = 0f
        val searchRadius = 0.5f
        
        for (point in dataPoints) {
            val distance = (point.position - position).magnitude()
            if (distance < searchRadius) {
                val weight = if (distance < 0.001f) {
                    return point.magnitude()
                } else {
                    1f / (distance * distance)
                }
                weightedSum += point.magnitude() * weight
                totalWeight += weight
            }
        }
        
        return if (totalWeight > 0f) weightedSum / totalWeight else 0f
    }
    
    private fun updateTexture(fieldData: Array<FloatArray>) {
        val flattenedData = FloatArray((gridResolution + 1) * (gridResolution + 1))
        var index = 0
        for (i in 0..gridResolution) {
            for (j in 0..gridResolution) {
                flattenedData[index++] = fieldData[i][j]
            }
        }
        
        val buffer = ByteBuffer.allocateDirect(flattenedData.size * 4)
            .order(ByteOrder.nativeOrder())
            .asFloatBuffer()
            .apply {
                put(flattenedData)
                position(0)
            }
        
        GLES30.glTexImage2D(
            GLES30.GL_TEXTURE_2D, 0, GLES30.GL_R32F,
            gridResolution + 1, gridResolution + 1,
            0, GLES30.GL_RED, GLES30.GL_FLOAT, buffer
        )
    }
    
    private fun loadShader(type: Int, shaderCode: String): Int {
        return GLES30.glCreateShader(type).also { shader ->
            GLES30.glShaderSource(shader, shaderCode)
            GLES30.glCompileShader(shader)
            
            val compileStatus = IntArray(1)
            GLES30.glGetShaderiv(shader, GLES30.GL_COMPILE_STATUS, compileStatus, 0)
            if (compileStatus[0] == 0) {
                val error = GLES30.glGetShaderInfoLog(shader)
                GLES30.glDeleteShader(shader)
                throw RuntimeException("Error compiling shader: $error")
            }
        }
    }
    
    fun setGridResolution(resolution: Int) {
        gridResolution = max(5, min(50, resolution))
        Log.i(TAG, "Heatmap grid resolution set to $gridResolution")
    }
    
    fun cleanup() {
        if (program != 0) {
            GLES30.glDeleteProgram(program)
            program = 0
        }
        if (textureId != 0) {
            GLES30.glDeleteTextures(1, intArrayOf(textureId), 0)
            textureId = 0
        }
    }
    
    companion object {
        private const val TAG = "HeatmapRenderer"
    }
}
